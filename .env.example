# alpha — docker compose overrides. Copy to .env and edit as needed:
#
#   cp .env.example .env
#
# docker compose reads .env from this directory automatically. Change any port
# that collides with something already running on your machine. Only the HOST
# side of each mapping changes — container-internal ports and the
# service-to-service URLs (db:5432, backend:8000) are unaffected, so no other
# file needs editing.

# Web app (open this in your browser) -> http://localhost:${ALPHA_WEB_PORT}
ALPHA_WEB_PORT=3000

# Backend API + Swagger docs           -> http://localhost:${ALPHA_API_PORT}
ALPHA_API_PORT=8000

# PostgreSQL / PostGIS (host access only; the backend reaches it as db:5432)
ALPHA_DB_PORT=5432

# PostgreSQL password for the `alpha` user. Defaults to "alpha" if unset, which
# is fine for a throwaway local stack but should be replaced with a random
# value for anything reachable beyond your own machine. Run scripts/gen-env.sh
# to generate one automatically, or set your own:
#   openssl rand -base64 24
ALPHA_DB_PASSWORD=

# Hostnames allowed to reach the web app when it's served behind a reverse proxy
# or tunnel (Cloudflare Tunnel, Nginx, …). Vite blocks unknown Host headers, so
# set this to the domain(s) you serve on — comma-separated, or "all" to allow any
# host. Leave empty for localhost-only access.
#   ALPHA_ALLOWED_HOSTS=alpha.example.com,alpha.internal.lan
ALPHA_ALLOWED_HOSTS=

# Live carbon price (Phase 4). FX already goes live out of the box (ECB via
# Frankfurter); carbon has no single free/keyless spot feed the same way, so it
# stays on the documented static reference (backend/reference_data.py) unless
# you point it at a real feed here. Ranked candidates (see backend/live_data.py's
# docstring for the full reasoning, caveats, and the JSON shapes understood):
#   1. Trading Economics "EU Carbon Permits" (tradingeconomics.com) — a free
#      guest tier exists; single-symbol queries return one flat JSON object
#      this module reads as-is. Prices in EUR, so convert to USD first.
#   2. Nasdaq Data Link's CHRIS/ICE_C1 dataset (data.nasdaq.com) — free with
#      registration, but returns OHLC arrays and needs a small shim to flatten.
#   3. World Bank Carbon Pricing Dashboard — not a live feed; better for
#      periodically refreshing CARBON_PRICE_USD_PER_TCO2 below than for this.
# None of these have been hit from this deployment's network — verify shape
# and auth against the provider's current docs first. Leave empty to keep the
# static reference.
#   CARBON_PRICE_URL=https://example.com/carbon-price.json
CARBON_PRICE_URL=

# Direct numeric override instead of a feed (USD per tonne CO2e) — wins over
# CARBON_PRICE_URL if both are set.
#   CARBON_PRICE_USD_PER_TCO2=65
CARBON_PRICE_USD_PER_TCO2=
